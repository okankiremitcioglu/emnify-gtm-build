    {
      "parameters": {
        "jsCode": "// Clean the payload from Clay and build the Salesforce Account body.\n// Picklists in Salesforce are restricted, so unknown values fall back to a safe default.\nconst SF = 'https://orgfarm-734be04959-dev-ed.develop.my.salesforce.com';\nconst VERTICALS = ['Fleet and mobility', 'EV charging and energy', 'Asset tracking and logistics',\n  'Point of sale', 'Healthcare', 'Security', 'Industrial', 'Consumer devices', 'Other'];\nconst BANDS = ['Under 1k', '1k-10k', '10k-100k', 'Over 100k', 'Unknown'];\n// The org uses country picklists, so send ISO codes for the countries we expect.\nconst COUNTRY = { germany: 'DE', deutschland: 'DE', 'united states': 'US', usa: 'US', us: 'US',\n  'united kingdom': 'GB', uk: 'GB', france: 'FR', netherlands: 'NL', sweden: 'SE', denmark: 'DK',\n  norway: 'NO', finland: 'FI', austria: 'AT', switzerland: 'CH', spain: 'ES', italy: 'IT',\n  belgium: 'BE', poland: 'PL', ireland: 'IE', israel: 'IL', canada: 'CA', 'czech republic': 'CZ',\n  czechia: 'CZ', portugal: 'PT', estonia: 'EE', lithuania: 'LT', turkey: 'TR', 'türkiye': 'TR' };\n\nconst toText = v => Array.isArray(v) ? v.join('\\n') : String(v ?? '');\nconst cut = (v, n) => (v ? String(v).slice(0, n) : null);\n\nreturn $input.all().map(item => {\n  const d = item.json.body ?? item.json;\n  const domain = String(d.domain ?? '').toLowerCase().trim()\n    .replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0];\n  const name = String(d.company_name ?? '').trim();\n  const tier = String(d.icp_tier ?? '').trim().toUpperCase();\n\n  let reason = '';\n  if (!domain || !domain.includes('.')) reason = 'missing or invalid domain';\n  else if (!name) reason = 'missing company name';\n  else if (!['A', 'B'].includes(tier)) reason = `tier ${tier || 'empty'} is not A or B`;\n\n  const version = d.rubric_version || 'v1';\n  const country = COUNTRY[String(d.country ?? '').toLowerCase().trim()];\n  const account = {\n    Name: name,\n    Website: `https://${domain}`,\n    NumberOfEmployees: Number(d.employees) || null,\n    ICP_Score__c: Math.max(0, Math.min(90, Number(d.icp_score) || 0)),\n    ICP_Tier__c: tier || null,\n    Rubric_Version__c: cut(version, 10),\n    IoT_Vertical__c: VERTICALS.includes(d.vertical) ? d.vertical : 'Other',\n    Device_Volume_Band__c: BANDS.includes(d.device_volume_band) ? d.device_volume_band : 'Unknown',\n    Connectivity_Tech__c: cut(d.connectivity_tech, 100),\n    Current_IoT_Provider__c: cut(d.current_provider, 100),\n    Why_Now__c: cut(d.why_now, 1000),\n    Signals__c: cut(toText(d.signals), 5000),\n    Source_URLs__c: cut(toText(d.source_urls), 2000),\n    Enriched_At__c: new Date().toISOString(),\n    Enrichment_Source__c: `Clay+n8n ${version}`,\n  };\n  if (country) account.BillingCountryCode = country;\n\n  return { json: { valid: !reason, reason, domain, tier, sf_url: SF, account, raw: d } };\n});\n"
      },
