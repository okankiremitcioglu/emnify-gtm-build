    {
      "parameters": {
        "jsCode": "// Clean the contact from Clay. The upsert key is the lowercase email,\n// or \"li:<profile slug>\" when there is no email.\nconst SF = 'https://orgfarm-734be04959-dev-ed.develop.my.salesforce.com';\nconst PERSONAS = ['Technical decision maker', 'Economic buyer', 'Champion'];\nconst STATUSES = ['Valid', 'Risky', 'Unknown'];\nconst cut = (v, n) => (v ? String(v).slice(0, n) : null);\n\nreturn $input.all().map(item => {\n  const d = item.json.body ?? item.json;\n  const domain = String(d.domain ?? '').toLowerCase().trim()\n    .replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0];\n  const email = String(d.email ?? '').toLowerCase().trim();\n  const linkedin = String(d.linkedin_url ?? '').trim();\n  const slug = (linkedin.match(/linkedin\\.com\\/in\\/([^/?#]+)/i) || [])[1];\n  const contactKey = email || (slug ? `li:${slug.toLowerCase()}` : '');\n  const lastName = String(d.last_name ?? '').trim();\n\n  let reason = '';\n  if (!domain) reason = 'missing domain';\n  else if (!contactKey) reason = 'no email and no LinkedIn URL';\n  else if (!lastName) reason = 'missing last name';\n\n  const contact = {\n    FirstName: cut(d.first_name, 40),\n    LastName: lastName,\n    Title: cut(d.title, 128),\n    LinkedIn_URL__c: linkedin || null,\n    Persona__c: PERSONAS.includes(d.persona) ? d.persona : null,\n    Opener__c: cut(d.opener, 1000),\n    Email_Status__c: STATUSES.includes(d.email_status) ? d.email_status : 'Unknown',\n  };\n  if (email) contact.Email = email;\n\n  // Escape quotes so the domain is safe inside SOQL.\n  const soqlDomain = domain.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\");\n  return { json: { valid: !reason, reason, domain, soqlDomain, contactKey, sf_url: SF, contact, raw: d } };\n});\n"
      },
